# Server port (Render sets PORT automatically)
PORT=5000

# MongoDB connection string (e.g. MongoDB Atlas)
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# JWT secret for signing tokens (use a long random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Frontend origin for CORS (e.g. https://your-app.vercel.app or http://localhost:5173 for local dev)
CLIENT_URL=http://localhost:5173
